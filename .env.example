# Copy to .env (or just run ./setup.sh, which creates it). Never commit .env.

# Required — protects the server. setup.sh generates one: openssl rand -hex 24
MEMORY_TOKEN=

# Your repos (read-only for ai-memory)
PROJECTS_DIR=/Users/<you>/Desktop/projects
# comma-separated folder names inside PROJECTS_DIR
CODE_PROJECTS=my-app

# Jira (optional) — your own API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SYNC_PROJECT=           # project key to sync daily and to auto-start task journals, e.g. PROJ

# Optional tuning (defaults shown)
# JIRA_SYNC_DAYS=90
# JIRA_SYNC_INTERVAL_HOURS=24
# JIRA_SYNC_TYPES=Story,Epic,Task,Bug,Sub-Bug,Research Task,Design Task
# AUTO_TASK_PREFIXES=PROJ     # default: JIRA_SYNC_PROJECT; * = any key
# CODE_REINDEX_SECONDS=600
# BACKUP_HOUR=10
# BACKUP_WEEKDAYS=0,1,2,3,4
# BACKUP_KEEP=30
# TZ=UTC                      # log time zone (setup.sh uses your Mac's)
# BACKUP_TZ=UTC               # backup schedule time zone

# Team memory sync (optional) — share memories with teammates through a git repo. See SETUP.md.
# SYNC_REPO_URL=https://dev.azure.com/<org>/<project>/_git/ai-memory-team
# SYNC_GIT_TOKEN=          # Azure DevOps PAT with Code (Read & write); never put it in the URL
# SYNC_AUTHOR=             # your folder in the repo, unique per person: lower-case, e.g. alice
# SYNC_BRANCH=main
# SYNC_INTERVAL_MINUTES=30 # 0 = only the "Sync now" button
# SYNC_GRACE_MINUTES=10    # new/edited memories wait this long before they are shared
